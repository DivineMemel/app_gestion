# ============================================================
# Supabase — Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Clé publique (publishable/anon). Exposée au navigateur : la RLS est
# verrouillée, cette clé n'a AUCUN accès aux tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Clé secrète (service_role). Serveur uniquement, ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE=sb_secret_xxx

# ============================================================
# Admin — bootstrap du patron
# ============================================================
# Mot de passe maître : ouvre un accès propriétaire même sans compte en base.
ADMIN_PASSWORD=change-moi

# Secret de signature des sessions (HMAC). Une longue chaîne aléatoire :
#   openssl rand -hex 32
# Il ne quitte JAMAIS le serveur. Le changer déconnecte tout le monde — c'est
# précisément ce qu'on veut en cas de doute sur une fuite.
SESSION_SECRET=change-moi-tres-long-et-aleatoire

# Ancien nom, encore accepté en repli si SESSION_SECRET est absent. Il servait
# aussi de VALEUR au cookie du patron : le secret de signature se promenait
# donc dans un cookie. Ce n'est plus le cas, mais autant finir la séparation —
# renseigne SESSION_SECRET et supprime cette ligne.
# ADMIN_TOKEN=

# ============================================================
# Notifications push (alerte nouvelle vente / stock bas)
# Générer les clés : npx web-push generate-vapid-keys
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nadalservices97@gmail.com

# ============================================================
# Envoi d'e-mails — « mot de passe oublié »
#
# UNE des deux clés suffit. Les deux fournisseurs ont une offre gratuite
# largement suffisante ici (quelques mails par mois) :
#
#   BREVO   300 mails/jour. Valider UNE adresse d'expéditeur dans Brevo
#           (Senders → Add a sender) et c'est tout : pas besoin de nom de
#           domaine, on écrit à n'importe quelle adresse. → le choix par défaut
#           tant que NADAL n'a pas de domaine.
#           Clé : app.brevo.com → SMTP & API → API keys
#
#   RESEND  3 000 mails/mois. Sans domaine vérifié, il n'accepte d'écrire QU'À
#           l'adresse du titulaire du compte — donc inutilisable pour l'équipe
#           avant d'avoir un domaine. À basculer le jour où il y en a un.
#           Clé : resend.com/api-keys
#
# Sans aucune clé, la page « mot de passe oublié » le dit franchement et
# renvoie vers le patron, qui pose un mot de passe provisoire depuis Comptes.
# ============================================================
BREVO_API_KEY=
# RESEND_API_KEY=

# Adresse d'expéditeur. Doit être VALIDÉE chez le fournisseur, sinon le mail
# part en erreur. À défaut, VAPID_SUBJECT est réutilisée.
MAIL_FROM=nadalservices97@gmail.com
MAIL_FROM_NAME=NADAL MULTISERVICES

# Le lien de réinitialisation est construit sur cette adresse : si elle est
# fausse, le mail arrive avec un lien qui ne mène nulle part.
# NEXT_PUBLIC_SITE_URL=https://nadal-multiservices.vercel.app
